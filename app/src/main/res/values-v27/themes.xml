<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Both of these landed in API 27, so they are declared in a versioned
         resource rather than guarded at runtime. A launcher's whole surface is
         its background, so drawing under a display cutout and tinting the
         navigation bar icons is not optional polish. -->
    <style name="Theme.Tide" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
